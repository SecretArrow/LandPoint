<!-- Onboarding step 1 (Welcome): a parcel plot with its five corner markers,
     and the pin that starts it. Monochrome by design (docs/DESIGN_SYSTEM.md
     §7) — the composable tints the whole drawing, so no colour lives here. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- The parcel outline, drawn the way a boundary is: corner to corner. -->
    <path
        android:pathData="M 26,132 L 88,110 L 174,122 L 122,178 L 54,170 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- A dot at every corner of the outline. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M 19,132 a 7,7 0 1,1 14,0 a 7,7 0 1,1 -14,0 Z
            M 81,110 a 7,7 0 1,1 14,0 a 7,7 0 1,1 -14,0 Z
            M 167,122 a 7,7 0 1,1 14,0 a 7,7 0 1,1 -14,0 Z
            M 115,178 a 7,7 0 1,1 14,0 a 7,7 0 1,1 -14,0 Z
            M 47,170 a 7,7 0 1,1 14,0 a 7,7 0 1,1 -14,0 Z" />

    <!-- The pin: where the first GPS fix lands on the ground. -->
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M 100,22 C 84,22 72,34 72,50 C 72,70 100,98 100,98 C 100,98 128,70 128,50 C 128,34 116,22 100,22 Z
            M 88,50 a 12,12 0 1,1 24,0 a 12,12 0 1,1 -24,0 Z" />
</vector>
